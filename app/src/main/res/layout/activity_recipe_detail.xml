<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8F4"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRecipeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe Name"
            android:textColor="#244B38"
            android:textSize="26sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Required Ingredients"
            android:textColor="#1F2937"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/tvIngredientsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="- Ingredient 1\n- Ingredient 2"
            android:textSize="15sp"
            android:textColor="#374151"
            android:paddingBottom="16dp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preparation Steps"
            android:textColor="#1F2937"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/tvInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Instructions go here..."
            android:textSize="15sp"
            android:textColor="#374151"
            android:lineSpacingExtra="6dp"
            android:paddingBottom="24dp" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Suggested Recipes"
            android:backgroundTint="#286747"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
