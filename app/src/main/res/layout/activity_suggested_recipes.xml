<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F7F8F4">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Suggested Recipes"
        android:textColor="#244B38"
        android:textSize="24sp"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recipes you can cook right now with strictly your current pantry items."
        android:textSize="13sp"
        android:textColor="#52645A"
        android:paddingBottom="16dp" />

    <ListView
        android:id="@+id/listSuggested"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#DCE5DD"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No recipes match your pantry yet - add more ingredients"
        android:textColor="#6B7280"
        android:textSize="16sp"
        android:visibility="gone" />

</LinearLayout>
