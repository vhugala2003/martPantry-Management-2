<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F7F8F4">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add / Edit Pantry Item"
        android:textColor="#244B38"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingredient Name *"
        android:textColor="#244B38"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g., Eggs, Milk, Flour"
        android:inputType="textPersonName"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quantity *"
        android:textColor="#244B38"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/etQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g., 2.0"
        android:inputType="numberDecimal"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Unit *"
        android:textColor="#244B38"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/etUnit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g., pieces, cup, g, ml, tbsp"
        android:inputType="text"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Expiry Date (Optional)"
        android:textColor="#244B38"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/etExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="YYYY-MM-DD"
        android:inputType="date"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Ingredient"
        android:backgroundTint="#286747"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delete Ingredient"
        android:backgroundTint="#DC2626"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

</LinearLayout>
